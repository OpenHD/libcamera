+bool H264Encoder::SetBitrate(unsigned int bitrate_bps)
+{
+	v4l2_control ctrl = {};
+	ctrl.id = V4L2_CID_MPEG_VIDEO_BITRATE;
+	ctrl.value = bitrate_bps;
+	if (xioctl(fd_, VIDIOC_S_CTRL, &ctrl) < 0)
+	{
+		LOG_ERROR("ERROR: failed to update H264 bitrate to " << bitrate_bps << ": " << strerror(errno));
+		return false;
+	}
+	LOG(1, "Updated H264 bitrate to " << bitrate_bps);
+	return true;
+}
